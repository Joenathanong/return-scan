# ─── scan-retur-v2 ───────────────────────────────────────────────────────────
# Salin file ini jadi `.env` lalu isi nilainya.
#   cp .env.example .env

# ─── Database: TiDB Cloud Starter ────────────────────────────────────────────
# Ambil dari TiDB Cloud → cluster Anda → Connect → pilih "Prisma".
# WAJIB pakai ?sslaccept=strict — TiDB Cloud menolak koneksi tanpa TLS.
#
# Bentuknya:
#   mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<database>?sslaccept=strict
#
# ⚠ NAMA DATABASE — bagian setelah port 4000, sebelum tanda tanya.
#   Connection string dari konsol TiDB Cloud sering terisi `sys` atau `test`.
#   `sys`, `mysql`, `information_schema`, `performance_schema`, dan `metrics_schema`
#   adalah database SISTEM. Kalau dipakai, `prisma db push` menolak dengan:
#       Error: P3004: The `sys` database is a system database
#   Buat database sendiri dulu lewat SQL Editor di konsol TiDB Cloud:
#       CREATE DATABASE IF NOT EXISTS scan_retur;
#   lalu pakai nama itu di URL bawah ini.
#
# ⚠ PASSWORD dengan karakter khusus. Kalau password mengandung
#   @ : / ? # [ ] , encode dulu (mis. @ jadi %40). Kalau tidak, URL salah
#   parse dan muncul "Can't reach database server".
#
# ⚠ `?sslaccept=strict` WAJIB ada — TiDB Cloud menolak koneksi tanpa TLS.
DATABASE_URL="mysql://xxxxxxx.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/scan_retur?sslaccept=strict"

# ─── Sesi ────────────────────────────────────────────────────────────────────
# Kunci penandatangan cookie sesi. WAJIB minimal 32 karakter dan RAHASIA.
# Kalau diganti, semua orang otomatis logout — itu normal.
# Buat nilainya dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ─── Admin pertama (dipakai `npm run db:seed`) ───────────────────────────────
# Wajib diganti saat login pertama — password di sini bukan password permanen.
ADMIN_EMAIL="admin@ptieg.co.id"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# ─── Google Sheets (OPSIONAL — hanya untuk EKSPOR) ───────────────────────────
# Beda besar dari sistem lama: G-Sheet BUKAN lagi jalur kritis scan.
# Kalau bagian ini dikosongkan, aplikasi tetap berjalan penuh — hanya tombol
# "Ekspor ke G-Sheet" yang tidak aktif. Scan tidak akan pernah gagal
# gara-gara Google.
#
# Share spreadsheet ke GOOGLE_SHEETS_CLIENT_EMAIL dengan role Editor.
GOOGLE_SHEETS_CLIENT_EMAIL=""
GOOGLE_SHEETS_PRIVATE_KEY=""
