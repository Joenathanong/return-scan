// scan-retur-v2 — TiDB Cloud Starter (MySQL)
//
// CATATAN PENTING soal relationMode:
//   Dipakai "prisma" (bukan foreign key sungguhan di database), sama seperti
//   project ieg-wms. Alasannya: pasti jalan di TiDB Cloud Starter tanpa perlu
//   diuji dulu. Konsekuensinya, integritas relasi dijaga di lapisan aplikasi
//   (semua tulis lewat prisma.$transaction di API route).
//   Kalau nanti mau FK sungguhan: hapus baris relationMode lalu `npm run db:push`.
//   Yang TIDAK terpengaruh: semua @unique di bawah tetap ditegakkan oleh
//   database — dan itulah yang menutup bug duplikat resi di sistem lama.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique(map: "uq_user_email") @db.VarChar(191)
  name         String  @db.VarChar(191)
  // scrypt dari node:crypto — sengaja TIDAK pakai bcrypt/argon2
  // supaya tidak ada native build yang harus dikompilasi saat npm install.
  passwordHash String  @map("password_hash") @db.VarChar(255)
  role         String  @default("operator") @db.VarChar(16) // admin | operator
  active       Boolean @default(true)
  // Dipaksa ganti password saat login pertama (dipakai untuk user hasil seed).
  mustChangePassword Boolean @default(true) @map("must_change_password")

  // ── Login satu perangkat ────────────────────────────────────────────────
  // `sesiAktif` adalah id acak yang dibuat setiap kali login berhasil, dan
  // ikut ditanam di dalam cookie sesi. requireUser() membandingkan keduanya
  // pada SETIAP request — gratis, karena baris user ini memang sudah dibaca
  // untuk mengecek `active`. Kalau tidak cocok, artinya akun ini sudah login
  // di perangkat lain, dan perangkat lama langsung diputus.
  //
  // Sifatnya "login terbaru menang", jadi tidak ada skenario admin terkunci
  // dari sistemnya sendiri: cukup login lagi.
  //
  // NULL = tidak ada sesi aktif (belum pernah login, sudah logout, atau
  // dikeluarkan admin lewat tombol "Keluarkan dari perangkat").
  sesiAktif      String?   @map("sesi_aktif") @db.VarChar(64)
  perangkatLabel String?   @map("perangkat_label") @db.VarChar(191)
  sesiSejak      DateTime? @map("sesi_sejak")

  // Izin modul. Sengaja BUKAN role baru: begitu ada modul ketiga, matriks
  // role akan meledak. Satu boolean per modul jauh lebih mudah dibaca dan
  // tidak mengubah arti role yang sudah dipakai di seluruh aplikasi.
  // Admin selalu boleh, tanpa melihat kolom ini.
  bisaBongkaran   Boolean @default(false) @map("bisa_bongkaran")
  bisaCancelOrder Boolean @default(false) @map("bisa_cancel_order")

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.VarChar(30)
  lastLogin DateTime? @map("last_login")

  karungDibuat Karung[]      @relation("KarungCreatedBy")
  scans        Scan[]        @relation("ScanBy")
  bongkaran    Bongkaran[]   @relation("BongkaranBy")
  cancelOrder  CancelOrder[] @relation("CancelOrderBy")

  @@index([active])
  @@map("users")
}

// ─── EXPEDISI ────────────────────────────────────────────────────────────────

model Expedisi {
  id String @id @default(cuid())

  // BEDA BESAR dari sistem lama: `code` sekarang field MANUAL yang stabil dan
  // UNIQUE. Di sistem lama ia di-generate ulang dari `name` setiap kali
  // disimpan (name.toUpperCase().replace(/\s+/g,"_").slice(0,20)), sehingga
  // sekali nama diralat, nama tab G-Sheet ikut berubah dan data lama jadi
  // "tab yatim". Sekarang ganti nama TIDAK menyentuh code.
  code String @unique(map: "uq_expedisi_code") @db.VarChar(32)
  name String @db.VarChar(191)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(30)

  karung      Karung[]
  scans       Scan[]
  claimSheet  ClaimExpedisiSheet?

  @@index([active])
  @@map("expedisi")
}

// ─── KARUNG ──────────────────────────────────────────────────────────────────

model Karung {
  id String @id @default(cuid())

  expedisiId String   @map("expedisi_id") @db.VarChar(30)
  expedisi   Expedisi @relation(fields: [expedisiId], references: [id])

  nomorKarung String @map("nomor_karung") @db.VarChar(64)

  // Tanggal bisnis (WIB), disimpan sebagai teks "YYYY-MM-DD".
  // Sengaja BUKAN DateTime: menghindari seluruh kelas bug timezone yang ada
  // di sistem lama (toISOString() UTC vs waktu lokal). Nilainya selalu
  // dihitung di SERVER pakai zona Asia/Jakarta, tidak pernah dari jam klien.
  date String @db.VarChar(10)

  status          String    @default("open") @db.VarChar(20) // open | locked | admin_unlocked
  lockedAt        DateTime? @map("locked_at")
  lockedById      String?   @map("locked_by") @db.VarChar(30)
  printedAt       DateTime? @map("printed_at")
  adminUnlockedAt DateTime? @map("admin_unlocked_at")
  adminUnlockedBy String?   @map("admin_unlocked_by") @db.VarChar(30)

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String   @map("created_by") @db.VarChar(30)
  createdBy   User     @relation("KarungCreatedBy", fields: [createdById], references: [id])

  scans Scan[]

  // Cegah dua karung dengan nomor sama untuk ekspedisi & tanggal yang sama.
  // Di sistem lama ini bisa terjadi dan bikin tanda terima ambigu.
  @@unique([expedisiId, date, nomorKarung], map: "uq_karung_exp_date_nomor")
  @@index([date])
  @@index([expedisiId])
  @@index([createdById])
  @@map("karung")
}

// ─── SCAN ────────────────────────────────────────────────────────────────────

model Scan {
  id String @id @default(cuid())

  noResi String @map("no_resi") @db.VarChar(64)

  // ── INTI PERBAIKAN ──────────────────────────────────────────────────────
  // TiDB/MySQL tidak punya partial unique index seperti Postgres, jadi
  // keunikan dijaga lewat kolom bayangan ini:
  //   status = "success"  → noResiUnik = noResi   (ditolak kalau sudah ada)
  //   status = "voided"   → noResiUnik = NULL     (slotnya bebas lagi)
  // MySQL mengizinkan BANYAK baris NULL di kolom UNIQUE, jadi semantiknya
  // persis sama dengan partial unique index.
  //
  // Efeknya: duplikat ditolak oleh MESIN DATABASE, bukan oleh pengecekan
  // aplikasi yang bisa balapan. Ini yang tidak mungkin dilakukan di Firestore.
  noResiUnik String? @unique(map: "uq_scan_resi") @map("no_resi_unik") @db.VarChar(64)

  karungId String @map("karung_id") @db.VarChar(30)
  karung   Karung @relation(fields: [karungId], references: [id])

  expedisiId String   @map("expedisi_id") @db.VarChar(30)
  expedisi   Expedisi @relation(fields: [expedisiId], references: [id])

  scannedById String   @map("scanned_by") @db.VarChar(30)
  scannedBy   User     @relation("ScanBy", fields: [scannedById], references: [id])
  scannedAt   DateTime @default(now()) @map("scanned_at")

  // Tanggal bisnis WIB — sama seperti Karung.date, dihitung di server.
  date String @db.VarChar(10)

  status String @default("success") @db.VarChar(16) // success | voided

  // Pembatalan scan (menggantikan "hapus baris di G-Sheet" yang dulu
  // membuat Firestore dan sheet berbeda selamanya). Datanya TIDAK dihapus,
  // hanya di-void — jejaknya tetap ada untuk audit.
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by") @db.VarChar(30)
  voidReason String?   @map("void_reason") @db.VarChar(255)

  @@index([date])
  @@index([date, expedisiId])
  @@index([karungId])
  @@index([expedisiId])
  @@index([scannedById])
  @@index([noResi])
  @@map("scans")
}

// ─── SETTINGS (satu baris, id = 1) ───────────────────────────────────────────

model Settings {
  id Int @id @default(1)

  namaPerusahaan  String @default("PT. IEG") @map("nama_perusahaan") @db.VarChar(191)
  noteTandaTerima String @map("note_tanda_terima") @db.Text

  // G-Sheet sekarang HANYA tujuan EKSPOR, bukan jalur kritis scan.
  // Kosongkan kalau tidak dipakai — aplikasi tetap berjalan normal.
  spreadsheetId String @default("") @map("spreadsheet_id") @db.VarChar(191)

  claimMasterSpreadsheetId String @default("") @map("claim_master_spreadsheet_id") @db.VarChar(191)

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(30)

  @@map("settings")
}

// ─── CLAIM ───────────────────────────────────────────────────────────────────

/**
 * Sheet claim per kode ekspedisi.
 *
 * Kuncinya `code`, BUKAN id ekspedisi. Ini disengaja: endpoint
 * /api/claim/upload mendeteksi ekspedisi dari prefix nomor resi dan bisa
 * menghasilkan kode yang belum terdaftar di master ekspedisi (mis. hasil
 * deteksi baru, atau "UNKNOWN" untuk resi yang tidak dikenali). Kalau tabel
 * ini mewajibkan ekspedisi terdaftar, sheet yang terlanjur dibuat otomatis
 * di Google Drive tidak akan bisa disimpan konfigurasinya dan hilang begitu
 * halaman dimuat ulang — persis alur yang berjalan di sistem lama.
 *
 * `expedisiId` diisi kalau kodenya memang cocok dengan master ekspedisi.
 */
model ClaimExpedisiSheet {
  code String @id @db.VarChar(32)

  expedisiId String?   @unique @map("expedisi_id") @db.VarChar(30)
  expedisi   Expedisi? @relation(fields: [expedisiId], references: [id])

  spreadsheetId String   @map("spreadsheet_id") @db.VarChar(191)
  url           String   @db.VarChar(500)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("claim_expedisi_sheets")
}

// ─── EKSPOR G-SHEET ──────────────────────────────────────────────────────────

/**
 * Catatan setiap kali satu tab G-Sheet ditulis ulang.
 *
 * Sistem lama menulis ke G-Sheet SATU BARIS PER SCAN (append), sehingga
 * kena batas 60 tulis/menit dan datanya bocor diam-diam. Sistem baru
 * menulis ULANG SELURUH TAB dengan values.update — 2 API call per tab per
 * hari, dan idempoten: dijalankan dua kali hasilnya sama persis.
 */
model SheetExport {
  id String @id @default(cuid())

  tabName    String   @map("tab_name") @db.VarChar(191)
  date       String   @db.VarChar(10)
  expedisiId String   @map("expedisi_id") @db.VarChar(30)

  rowCount   Int      @map("row_count")
  status     String   @db.VarChar(16) // ok | failed
  error      String?  @db.VarChar(500)
  exportedAt DateTime @default(now()) @map("exported_at")
  exportedBy String?  @map("exported_by") @db.VarChar(30)

  @@index([date])
  @@index([tabName])
  @@map("sheet_exports")
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id String @id @default(cuid())

  userId    String?  @map("user_id") @db.VarChar(30)
  userName  String   @map("user_name") @db.VarChar(191)
  action    String   @db.VarChar(64)
  detail    String   @db.VarChar(500)
  metadata  String?  @db.Text // JSON string — MySQL/Prisma tidak punya scalar list
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([userId])
  @@map("audit_log")
}

// ═══════════════════════════════════════════════════════════════════════════
// MODUL BONGKARAN RETUR
// ═══════════════════════════════════════════════════════════════════════════

// ─── MASTER PRODUK ───────────────────────────────────────────────────────────

/**
 * Produk, dikunci oleh kode SKU.
 *
 * `updatedAt` diindeks karena inilah tumpuan sinkron cache PDT: klien
 * mengirim penanda waktu sinkron terakhir, server hanya membalas baris yang
 * berubah sesudahnya. Hari pertama seluruh master terkirim sekali; hari-hari
 * berikutnya biasanya nol baris.
 *
 * Produk yang tidak dipakai lagi ditandai `active = false`, TIDAK dihapus —
 * baris yang terhapus tidak akan pernah muncul di sinkron delta, sehingga
 * cache PDT akan menyimpannya selamanya.
 */
model Produk {
  sku  String @id @db.VarChar(64)
  nama String @db.VarChar(191)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(30)

  barcodes ProdukBarcode[]

  @@index([updatedAt])
  @@index([active])
  @@map("produk")
}

/**
 * Barcode → SKU, tabel terpisah karena satu SKU sering punya lebih dari satu
 * barcode: karton vs pcs, kemasan lama vs kemasan baru, barcode pabrik vs
 * barcode internal. Kalau digabung jadi satu kolom di Produk, penambahan
 * barcode kedua berarti membongkar tabel dan seluruh cache PDT.
 */
model ProdukBarcode {
  barcode String @id @db.VarChar(64)

  /**
   * PRODUK | BPOM
   *
   * BPOM = barcode nomor izin edar. Di banyak produk kosmetik dan obat,
   * justru inilah yang paling mudah terbaca scanner: dicetak besar dan rapi,
   * sementara barcode dagangnya sering tertutup stiker promo atau sudah lecet.
   *
   * Disimpan di TABEL YANG SAMA dengan barcode dagang, dibedakan kolom ini —
   * bukan sebagai kolom `barcode_bpom` terpisah di tabel produk. Alasannya
   * menentukan: pencarian saat scan tidak boleh peduli jenisnya sama sekali.
   * Operator mengarahkan scanner ke apa pun yang terbaca, dan sistem harus
   * menemukan produknya lewat SATU kali lookup, bukan dua percobaan
   * berturutan. Kalau dipisah jadi kolom sendiri, setiap scan yang gagal di
   * kolom pertama harus mencoba kolom kedua — dua kali kerja di jalur yang
   * paling sering dilewati, hanya demi bentuk tabel yang kebetulan terasa
   * lebih rapi dibaca manusia.
   */
  jenis String @default("PRODUK") @db.VarChar(10)

  sku    String @db.VarChar(64)
  produk Produk @relation(fields: [sku], references: [sku])

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sku])
  @@index([updatedAt])
  @@map("produk_barcode")
}

/**
 * Batch yang pernah dipakai per SKU — sumber auto-suggest.
 *
 * Isinya TIDAK datang dari impor master, melainkan tumbuh sendiri dari hasil
 * scan (itu yang dipilih user). Konsekuensinya daftar saran memang kosong di
 * hari pertama dan makin kaya seiring pemakaian.
 *
 * Batch dari item berkondisi ISI_SALAH tidak masuk ke sini: item itu tidak
 * punya SKU, dan batch tanpa SKU tidak bisa dipakai menyarankan apa pun.
 */
model BatchSku {
  id String @id @default(cuid())

  sku    String @db.VarChar(64)
  batch  String @db.VarChar(32)
  edDate String @map("ed_date") @db.VarChar(10) // "YYYY-MM-DD"

  /** Berapa kali batch ini pernah di-scan — dipakai mengurutkan saran. */
  dipakai Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sku, batch], map: "uq_batch_sku")
  @@index([updatedAt])
  @@map("batch_sku")
}

// ─── BONGKARAN ───────────────────────────────────────────────────────────────

/**
 * Satu baris per RESI yang dibongkar.
 *
 * `scannedAt` ditulis SERVER pada saat resi di-scan (POST /api/bongkaran/mulai),
 * bukan pada saat Simpan. Jam PDT yang meleset tidak bisa merusak data.
 *
 * status:
 *   draft  → resi sudah di-scan, barang belum disimpan (PDT masih mengisi)
 *   final  → sudah disimpan lengkap
 *   voided → dibatalkan, datanya tetap ada untuk audit
 *
 * TIDAK ada UNIQUE pada noResi: satu resi bisa sah dibongkar lebih dari sekali
 * (dua koli, satu nomor resi). Duplikat DIPERINGATKAN di layar, bukan ditolak.
 */
model Bongkaran {
  id String @id @default(cuid())

  noResi String @map("no_resi") @db.VarChar(64)

  scannedAt DateTime @map("scanned_at")

  /**
   * true bila stempel server gagal diambil (PDT offline saat scan resi) dan
   * klien terpaksa memakai jam lokalnya. Ditandai supaya baris seperti ini
   * bisa ditelusuri di dashboard, bukan diam-diam dianggap sama sahihnya.
   */
  waktuDariKlien Boolean @default(false) @map("waktu_dari_klien")

  /**
   * Kunci idempoten dari klien, HANYA untuk jalur luring.
   *
   * Jalur normal sudah aman dengan sendirinya: kirim ulang akan menemukan
   * draft yang statusnya bukan lagi `draft` dan ditolak. Jalur luring tidak
   * punya draft — kalau balasan hilang di jaringan setelah server menulis,
   * operator menekan Simpan lagi dan resi yang sama masuk dua kali, terlihat
   * persis seperti koli kedua yang sah. Kolom ini yang mencegahnya.
   *
   * NULL untuk semua baris jalur normal, dan MySQL mengizinkan banyak NULL
   * di kolom UNIQUE — pola yang sama dengan `no_resi_unik` di tabel scans.
   */
  klienKunci String? @unique(map: "uq_bongkaran_klien") @map("klien_kunci") @db.VarChar(64)

  /**
   * Nomor kamera CCTV yang mengawasi meja bongkar: 1–4.
   *
   * Gunanya menjembatani data dan rekaman. `scanned_at` sudah menjawab
   * "jam berapa", dan kolom ini menjawab "kamera mana" — dua-duanya
   * diperlukan untuk membuka rekaman yang benar ketika sebuah baris
   * dipertanyakan.
   *
   * NULLABLE, dan itu disengaja: seluruh baris yang tercatat SEBELUM fitur
   * ini ada memang tidak punya nomor kamera. Memberi nilai bawaan 1 akan
   * membuat ribuan baris lama mengaku diawasi kamera 1 — pernyataan yang
   * tidak pernah ada yang membuatnya, dan justru menyesatkan orang yang
   * kelak mencari rekamannya.
   */
  kamera Int? @db.SmallInt

  /**
   * Catatan bebas dari operator. Terutama untuk paket yang label resinya
   * sobek: nomor karung, sisa digit yang masih terbaca, bentuk kardusnya.
   *
   * NULLABLE dan opsional. Memaksanya diisi berarti memaksa operator
   * mengetik sesuatu di layar sentuh sambil memegang cutter — dan yang
   * diketik dalam keadaan itu adalah "-", bukan keterangan.
   */
  catatan String? @db.VarChar(191)

  scannedById String @map("scanned_by") @db.VarChar(30)
  scannedBy   User   @relation("BongkaranBy", fields: [scannedById], references: [id])

  /** Tanggal bisnis WIB "YYYY-MM-DD", dihitung di server. */
  date String @db.VarChar(10)

  status      String    @default("draft") @db.VarChar(16)
  finalizedAt DateTime? @map("finalized_at")

  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by") @db.VarChar(30)
  voidReason String?   @map("void_reason") @db.VarChar(255)

  items BongkaranItem[]

  @@index([date])
  @@index([noResi])
  @@index([status])
  @@index([scannedById])
  @@map("bongkaran")
}

/**
 * Satu baris per BARANG di dalam resi.
 *
 * `sku` dan `namaProduk` adalah SNAPSHOT, bukan relasi. Kalau nama produk di
 * master diralat bulan depan, hasil scan hari ini harus tetap menampilkan
 * nama yang dibaca petugas saat itu.
 *
 * KOLOM YANG BOLEH NULL, DAN KAPAN:
 *   barcode / sku / namaProduk → NULL HANYA bila kondisi = ISI_SALAH.
 *   namaDiterima               → WAJIB bila kondisi = ISI_SALAH, selain itu NULL.
 *   batch / edDate             → opsional HANYA bila kondisi = ISI_SALAH.
 * Aturan ini ditegakkan di lapisan API (lib/bongkaran.ts), bukan sekadar
 * diharapkan: item BAGUS/RUSAK_KEMASAN/RUSAK_TOTAL tanpa barcode ditolak 400.
 */
model BongkaranItem {
  id String @id @default(cuid())

  bongkaranId String    @map("bongkaran_id") @db.VarChar(30)
  bongkaran   Bongkaran @relation(fields: [bongkaranId], references: [id])

  urutan Int

  /** BAGUS | RUSAK_KEMASAN | RUSAK_TOTAL | ISI_SALAH */
  kondisi String @db.VarChar(20)

  barcode    String? @db.VarChar(64)
  sku        String? @db.VarChar(64)
  namaProduk String? @map("nama_produk") @db.VarChar(191)

  /**
   * Barcode ADA dan tersimpan, tapi belum terdaftar di Master Produk.
   * Beda dari ISI_SALAH, yang memang tidak punya barcode sama sekali.
   */
  produkTidakDikenal Boolean @default(false) @map("produk_tidak_dikenal")

  /** Nama barang yang benar-benar diterima — hanya untuk ISI_SALAH. */
  namaDiterima String? @map("nama_diterima") @db.VarChar(191)

  qty Int

  batch String? @db.VarChar(32)

  /** Hasil baca pola batch 6 karakter; NULL bila batch tidak berpola. */
  mfgDate String? @map("mfg_date") @db.VarChar(10)
  edDate  String? @map("ed_date") @db.VarChar(10)

  /** true bila ED diisi otomatis dari batch dan TIDAK diubah manual. */
  edOtomatis Boolean @default(false) @map("ed_otomatis")

  scannedAt DateTime @map("scanned_at")

  @@index([bongkaranId])
  @@index([sku])
  @@index([kondisi])
  @@map("bongkaran_item")
}

// ═══════════════════════════════════════════════════════════════════════════
// CANCEL ORDER
// ═══════════════════════════════════════════════════════════════════════════

/**
 * Satu SESI input gabungan barang batal kirim.
 *
 * Bedanya dengan Bongkaran, dan kenapa bentuknya memang harus berbeda:
 * barang cancel order TIDAK punya nomor resi — ia batal sebelum sempat
 * dikirim. Ia juga tidak dibongkar satu paket per satu paket; barangnya
 * menumpuk di rak dulu, lalu dicatat sekaligus. Jadi yang mengelompokkan
 * data di sini adalah SESI PENCATATAN, bukan paket.
 *
 * Konsekuensi yang disengaja: `recordedAt` adalah waktu PENCATATAN, bukan
 * waktu barang di-scan satu per satu. Di Bongkaran, jarak antar-barang
 * bermakna (berapa lama satu paket dibongkar); di sini tidak — barangnya
 * sudah lama tergeletak di rak, dan yang layak dicatat adalah kapan
 * seseorang duduk dan mendaftarnya. Mengarang stempel waktu per barang di
 * sini hanya akan membuat data terlihat lebih presisi daripada kenyataannya.
 */
model CancelOrder {
  id String @id @default(cuid())

  /** Nomor rujukan yang bisa disebut orang: "CO-20260908-003". */
  kode String @unique(map: "uq_cancel_order_kode") @db.VarChar(32)

  /** Keterangan bebas: asal barang, nomor berita acara, dsb. */
  catatan String? @db.VarChar(255)

  /** Tanggal bisnis WIB "YYYY-MM-DD", dihitung di server. */
  date String @db.VarChar(10)

  recordedAt   DateTime @map("recorded_at")
  recordedById String   @map("recorded_by") @db.VarChar(30)
  recordedBy   User     @relation("CancelOrderBy", fields: [recordedById], references: [id])

  /** final | voided. Tidak ada draft: pencatatan di sini sekali jalan. */
  status String @default("final") @db.VarChar(16)

  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by") @db.VarChar(30)
  voidReason String?   @map("void_reason") @db.VarChar(255)

  items CancelOrderItem[]

  @@index([date])
  @@index([status])
  @@index([recordedById])
  @@map("cancel_order")
}

/**
 * Satu baris barang dalam sesi.
 *
 * Yang dicatat hanya tiga hal — produk, jumlah, batch — sesuai permintaan.
 * `edDate` ikut disimpan HANYA kalau batch-nya berpola tanggal dan bisa
 * dibaca otomatis; ia gratis (aturannya sudah ada di lib/bongkaran.ts) dan
 * berguna kalau nanti barangnya mau dijual lagi. Tidak pernah wajib.
 *
 * `sku` dan `namaProduk` adalah SNAPSHOT, sama seperti di Bongkaran: nama
 * produk yang diralat bulan depan tidak boleh mengubah catatan bulan ini.
 */
model CancelOrderItem {
  id String @id @default(cuid())

  cancelOrderId String      @map("cancel_order_id") @db.VarChar(30)
  cancelOrder   CancelOrder @relation(fields: [cancelOrderId], references: [id])

  urutan Int

  barcode    String? @db.VarChar(64)
  sku        String? @db.VarChar(64)
  namaProduk String  @map("nama_produk") @db.VarChar(191)

  /** Barcode tercatat tapi belum terdaftar di Master Produk. */
  produkTidakDikenal Boolean @default(false) @map("produk_tidak_dikenal")

  qty Int

  batch      String? @db.VarChar(32)
  mfgDate    String? @map("mfg_date") @db.VarChar(10)
  edDate     String? @map("ed_date") @db.VarChar(10)
  edOtomatis Boolean @default(false) @map("ed_otomatis")

  @@index([cancelOrderId])
  @@index([sku])
  @@map("cancel_order_item")
}
